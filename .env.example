# VBL Economics Lab - Environment Variables
# Copy this file to .env and fill in your values

# FRED API Key (required for data ingestion)
# Get a free key from https://fred.stlouisfed.org/
FRED_API_KEY=your_fred_api_key_here

# Model parameters
MIN_QUARTERS_FOR_RELEASE=20
HEAT_THRESHOLD_C=38.0

# Ingestion
INGEST_START_DATE=2015-01-01

# Logging
LOG_LEVEL=WARNING
LOG_FORMAT=console  # or json

# Bootstrap resamples for the oil-effect interval in `pwl train`
BOOTSTRAP_SAMPLES=300
